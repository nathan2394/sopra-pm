# SOPRA PM backend (.NET)
#
# ConnectionStrings__DefaultConnection maps to ConnectionStrings:DefaultConnection
# ("__" is the config hierarchy separator). When it is set it wins outright and
# the MSSQL_* keys below are ignored.
#
# This file is gitignored — keep real credentials here, not in appsettings.json.
ConnectionStrings__DefaultConnection=Server=your-host,1433;Database=SOPRA_PM;User Id=your-user;Password=your-password;TrustServerCertificate=true;MultipleActiveResultSets=true;Connection Timeout=30;Command Timeout=30;Max Pool Size=100;Min Pool Size=5;Pooling=true

# Fallback, used only when DefaultConnection is unset (the Python backend's keys).
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong!Passw0rd
MSSQL_DB=SOPRA_PM
# Dev containers use a self-signed certificate; set to false once a real one is installed.
MSSQL_TRUST_CERT=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# CORS (frontend origin); "*" is fine for local dev
CORS_ORIGINS=*

# Default password given to every seeded account
SEED_DEFAULT_PASSWORD=SopraPM@2026

# Swagger UI. Unset = on in Development, off elsewhere. Uncomment and set true
# to expose it on a deployed server (it publishes the whole API surface).
#SWAGGER_ENABLED=true
